API_DOMAIN=api.nezfocus.app
BACKEND_IMAGE=ghcr.io/<github-owner>/nezfocus-backend:latest

POSTGRES_USER=nezfocus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nezfocus

# Must match infra/seaweedfs/s3.prod.json
S3_ACCESS_KEY=nezfocus
S3_SECRET_KEY=change-me

# Access-token signing key (backend). Generate: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long
