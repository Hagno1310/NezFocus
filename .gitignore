# Single ignore file for the whole monorepo.

# ── Dependencies & package managers
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build output & caches
dist/
build/
coverage/
*.tsbuildinfo
.cache/
.eslintcache
.vite/

# ── Env & secrets (commit only *.example)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
google-services.json
service-account*.json
infra/seaweedfs/s3.prod.json

# ── Expo / React Native (apps/mobile)
.expo/
expo-env.d.ts
web-build/
.metro-health-check*
*.orig.*
.kotlin/
# Generated by `expo prebuild` (CNG, ADR-02): configure via app.config.ts / plugins/
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab

# ── Mascot (packages/mascot): build/ is regenerated by `rive .`; dist/runtime.riv is the shipped file
!packages/mascot/dist/
__pycache__/
*.pyc

# ── Local tool state
.superpowers/
.claude/settings.local.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.log
