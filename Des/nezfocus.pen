                    6,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "frame",
                      "id": "u2vBJ",
                      "name": "Code block",
                      "clip": true,
                      "width": "fill_container",
                      "fill": "$surface-2",
