# Metro inlines this at bundle time. On a real phone use your PC LAN IP, e.g. http://192.168.1.10:3000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1

# Areas served by Fake<X>Repository instead of the backend: folder names under src/data/, comma-separated (docs/WORKFLOW.md 4.2). Empty = real backend.
EXPO_PUBLIC_FAKE=
