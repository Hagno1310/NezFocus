PORT=3000
DATABASE_URL=postgres://nezfocus:nezfocus@localhost:5432/nezfocus
REDIS_URL=redis://localhost:6379
# Dev only. Production: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
S3_ENDPOINT=http://localhost:8333
# Phone on the same Wi-Fi: presigned upload URLs must use the PC's LAN IP (getting-started §2)
# S3_PUBLIC_ENDPOINT=http://192.168.1.10:8333
S3_ACCESS_KEY=nezfocus
S3_SECRET_KEY=nezfocus-dev-secret
S3_BUCKET=nezfocus
# REQ-VC-01: the app dials LIVEKIT_URL; a phone needs this PC's LAN IP (same value as
# LIVEKIT_NODE_IP in infra/.env), e.g. ws://192.168.1.20:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-only-livekit-secret-0123456789abcdef
# `pnpm db:seed`: 16 sample accounts <username>@gmail.com, password NezFocus@2026 (docs/WORKFLOW.md 4.4)
# REQ-SRV-07: download button of /invite/<code> and App Link fingerprints (comma separated)
APP_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=app.nezfocus
ANDROID_CERT_SHA256=
