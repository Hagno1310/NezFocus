                      "strokeWidth": 1,
                      "layout": "vertical",
                      "gap": 2,
                      "padding": 12,
                      "children": [
                        {
                          "type": "text",
                          "id": "CnoDo",
                          "name": "Code line",
                          "fill": "$text-primary",
                          "content": "from scipy.integrate import dblquad",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "d5tqx",
                          "name": "Code line",
                          "fill": "$text-primary",
                          "content": "import numpy as np",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "IiL04",
                          "name": "Code line",
                          "fill": "$text-primary",
                          "content": "f = lambda r, phi: (r*np.cos(phi))**2 * r  # nhớ nhân r",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "YvI6x",
                          "name": "Code line",
                          "fill": "$text-primary",
                          "content": "print(dblquad(f, 0, np.pi, lambda p: 0, lambda p: 2))",
                          "lineHeight": 1.5,
                          "fontFamily": "$font-mono",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
