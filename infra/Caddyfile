# TLS is automatic once API_DOMAIN's and TURN_DOMAIN's DNS point at this VM. 443 reaches Caddy
# through the router (nginx/nginx.conf.template).
{$API_DOMAIN} {
	encode gzip
	# REQ-VC-01: the app dials wss://API_DOMAIN/livekit (LiveKit signalling).
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}
	reverse_proxy backend:3000
}

# REQ-VC-08 (CR-28 #4): only so Caddy holds a certificate LiveKit's TURN/TLS can load.
{$TURN_DOMAIN} {
	respond 404
}
